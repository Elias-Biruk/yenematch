# Database
# For local development with Docker Compose (port 5433 to avoid conflicts):
DATABASE_URL=postgresql://yene_match_user:yene_match_password@localhost:5433/yene_match

# For local PostgreSQL installation (default port 5432):
# DATABASE_URL=postgresql://your_user:your_password@localhost:5432/yene_match

# Telegram (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Application
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NODE_ENV=development

# Public Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=@your_bot_username

# Development Authentication (ONLY for local development)
# Set to "true" to enable development login without Telegram
# NEVER set this in production
DEV_AUTH=false

# Optional: Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379

# Image Storage (Required for photo upload) - Get from Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
